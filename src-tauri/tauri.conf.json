{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ETS2 Coach Volume Controller",
  "version": "1.0.0",
  "identifier": "com.ets2coach.volume",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ETS2 코치 사운드 볼륨 조절기",
        "width": 1140,
        "height": 840,
        "minWidth": 900,
        "minHeight": 580
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
